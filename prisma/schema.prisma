// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String          @id @default(cuid())
  name                String?
  email               String?         @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  username            String?         @unique
  level               UserLevel       @default(BEGINNER)
  onboardingCompleted Boolean         @default(false)
  role                UserRole?
  domain              String[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  accounts            Account[]
  sessions            Session[]
  userProjects        UserProject[]
  submissions         Submission[]
  aiinteractions      AIInteraction[]
  userSkills          UserSkill[]
}

enum UserLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UserRole {
  STUDENT
  ANALYST
  MANAGER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  // role          String @default()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Dataset {
  id            String    @id @default(cuid())
  name          String
  description   String?
  datasetConfig Json
  createdAt     DateTime  @default(now())
  projects      Project[]
  files         File[]
}

model Project {
  id           String          @id @default(cuid())
  title        String
  description  String?
  category     String?
  difficulty   DifficultyLevel
  domain       Domain
  datasetId    String?
  dataset      Dataset?        @relation(fields: [datasetId], references: [id])
  createdAt    DateTime        @default(now())
  userProjects UserProject[]
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Domain {
  FINANCE
  MARKETING
  HEALTHCARE
  OPERATIONS
}

model UserProject {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id])
  status         ProgressStatus @default(NOT_STARTED)
  progress       Float?
  score          Float?
  grade          String?
  aiFeedback     Json?
  aiQuestions    Json?
  attemptCount   Int            @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  lastActivityAt DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, projectId])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model File {
  id              String           @id @default(cuid())
  url             String
  format          String // csv, json, png, pdf
  type            FileType
  ownerType       FileOwnerType
  createdAt       DateTime         @default(now())
  datasetId       String?
  dataset         Dataset?         @relation(fields: [datasetId], references: [id])
  aiFiles         AIFile[]
  submissionFiles SubmissionFile[]
}

enum FileType {
  DATASET
  SUBMISSION
  AI_GENERATED
}

enum FileOwnerType {
  USER
  AI
  SYSTEM
}

model Submission {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  taskId    String?
  content   String?
  score     Float?
  feedback  String?
  createdAt DateTime         @default(now())
  files     SubmissionFile[]
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  fileId       String
  submission   Submission @relation(fields: [submissionId], references: [id])
  file         File       @relation(fields: [fileId], references: [id])
}

model AIInteraction {
  id        String            @id @default(cuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  type      AIInteractionType
  input     Json
  output    Json?
  createdAt DateTime          @default(now())
  files     AIFile[]
}

model AIFile {
  id              String        @id @default(cuid())
  aiInteractionId String
  fileId          String
  aiInteraction   AIInteraction @relation(fields: [aiInteractionId], references: [id])
  file            File          @relation(fields: [fileId], references: [id])
}

enum AIInteractionType {
  TASK_GENERATION
  FEEDBACK
  DATASET_ANALYSIS
}

model UserSkill {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  skill      Json
  confidence Float?
  updatedAt  DateTime @updatedAt

  @@unique([userId])
}

